# Copy this file to .env and fill in what you need. Nothing here is required
# to start the app.
#
# HOW KEYS WORK WITH MULTIPLE USERS
#   Everyone signs in with their own account and enters THEIR OWN AI key, Gmail
#   App Password, etc. under Settings > Connections (stored encrypted, per person).
#   The keys below are only a fallback for the ADMIN (the first account), so a
#   .env you already set up keeps working. Other people never use them --
#   except AI keys, if you set SHARE_LLM_WITH_USERS=1.

# ---- LLM (pick one provider; free tiers work) --------------------------------
LLM_PROVIDER=groq                 # groq | openai | gemini
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash   # model names change -- set this if you get a 404
# Optional: use a different provider per job
# LLM_PROVIDER_DRAFT=groq
# LLM_PROVIDER_ENRICH=openai
# LLM_PROVIDER_FILTER=gemini

# ---- Email sending + reply checking (Gmail: use an App Password) -------------
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM_NAME=Kunal
# IMAP_USER=            # defaults to SMTP_USER
# IMAP_PASS=            # defaults to SMTP_PASS
# IMAP_HOST=imap.gmail.com

# ---- Enrichment web search (free plan = 100 searches/month) ------------------
SERPAPI_KEY=
# SERPAPI_MONTHLY_LIMIT=100
# ENRICH_MAX_SEARCHES=3           # searches per lead

# ---- Scraping ------------------------------------------------------------------
# Instagram scraping needs a BURNER account -- never your real one
IG_USERNAME=
IG_PASSWORD=
# SCRAPER_HEADLESS=true           # set false to watch the browser
# SCRAPER_BROWSER_CHANNEL=chrome  # use your installed Chrome instead of downloading Chromium
# Speed vs. caution (seconds). Lower = faster, but a higher chance of a CAPTCHA.
# SCRAPER_SCROLL_DELAY_MIN=0.7    # pause between scrolls of the results list
# SCRAPER_SCROLL_DELAY_MAX=1.3
# SCRAPER_DETAIL_DELAY_MIN=0.4    # pause between batches of listing pages
# SCRAPER_DETAIL_DELAY_MAX=0.9
# SCRAPER_DETAIL_TABS=2           # listing pages loaded at once (1-4). Use 1 if the server runs out of memory.
# SCRAPER_RECYCLE_EVERY=20        # open fresh tabs after this many listings (keeps memory flat on long runs)
# SCRAPER_BLOCK_MEDIA=true        # don't download images while scraping

# ---- Accounts & hosting --------------------------------------------------------
# DATA_DIR=data                   # every user's database + login secrets live here. BACK IT UP.
# SECRET_KEY=                     # signs logins and encrypts saved keys. Auto-created in DATA_DIR
#                                 #   if unset; set it yourself on a server so redeploys keep it.
#                                 #   Changing it signs everyone out and clears saved keys.
# ALLOW_SIGNUP=1                  # 0 = nobody new can create an account
# SIGNUP_CODE=                    # if set, creating an account needs this code (invite-only)
# SHARE_LLM_WITH_USERS=0          # 1 = users without their own AI key may use the admin's
# COOKIE_SECURE=0                 # set to 1 when served over HTTPS
# TRUST_PROXY=0                   # set to 1 behind a reverse proxy / hosting platform
# HOST=127.0.0.1
# PORT=5000
# HUB_DB=hub.db                   # an OLD single-user database; adopted by the first account
# DEFAULT_COUNTRY_CODE=1          # assumed country for phone numbers without one
# EMAIL_DAILY_LIMIT=40            # starting values; editable later in Settings
# EMAIL_SEND_DELAY_SECONDS=45

# ---- Keeping data safe on hosts that wipe their disk (see README: Free-tier guide) ----
# Copy encrypted snapshots to Supabase Storage (or any S3-compatible bucket). Needs: pip install -r requirements-cloud.txt
# S3_BUCKET=nexus-reach-data
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=nexusreach/
# ...or copy to a folder instead (a Dropbox/Google Drive/USB folder works):
# SYNC_FOLDER=
# SECRET_KEY=                       # REQUIRED when copying anywhere. Keep a copy in a password manager.
# SECRET_KEY_OLD=                   # while rotating: the previous key (comma-separate several)
# SYNC_INTERVAL_SECONDS=60
# BACKUP_KEEP_DAYS=7
# STORAGE_BUDGET_MB=800             # oldest daily backups are dropped before you pass this

# ---- Limits that protect a small free server ------------------------------------------
# MAX_USERS=25
# MAX_LEADS_PER_USER=5000
# MAX_QUEUED_SCRAPES=3
# RATE_LIMIT_PER_MIN=600            # per person; 0 turns the limiter off
# PW_ITERATIONS=600000              # password hashing cost; lower ONLY if sign-in is unbearably slow
# ALLOW_PRIVATE_HOSTS=0             # 1 = let the server call private/internal addresses (self-hosters only)
